# Copy to .env and fill in. .env is gitignored — never commit the real key.
#
#   cp .env.example .env && set -a && . ./.env && set +a

# Free key from https://www.vbb.de/vbb-services/api-open-data/
VBB_ACCESS_ID=

# The test system VBB issues keys against. Production is a different host and
# is granted separately -- a test key there fails as API_AUTH, not as a 404.
VBB_API_BASE=https://vbb.demo.hafas.cloud/api/fahrinfo/latest

# simulator (default, offline) | vbb | bvg
BAHNWATCH_SOURCE=vbb

# Defaults: 20s on the simulator, 60s live. Lower values burn the VBB quota.
# BAHNWATCH_POLL_SECONDS=60

# Stop IDs — look them up with `python scripts/find_stops.py`
STOP_BLANKENBURG=900142001
STOP_FRIEDRICHSTR=900100001

# SERVER_DEFAULT (portable) | OFF (suppresses realtime — makes everything look
# punctual) | FULL (documented by HAFAS, rejected by the VBB test system)
# VBB_RT_MODE=SERVER_DEFAULT
