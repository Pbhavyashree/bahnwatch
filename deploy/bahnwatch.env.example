# Install to /etc/bahnwatch/bahnwatch.env, owned by root, mode 0600.
#   sudo install -D -m 600 -o root -g root bahnwatch.env.example \
#        /etc/bahnwatch/bahnwatch.env
#
# systemd reads this as the service user; nothing here is in the repo.

VBB_ACCESS_ID=
VBB_API_BASE=https://vbb.demo.hafas.cloud/api/fahrinfo/latest

# Stop IDs. Verify with `python scripts/find_stops.py` before trusting them --
# a wrong one watches the wrong platform without failing.
STOP_BLANKENBURG=900142001
STOP_FRIEDRICHSTR=900100001

# 60s inside the commute window, 600s outside it. A once-a-day journey does not
# need a minute-resolution poll at 04:00, and the key has a budget.
BAHNWATCH_POLL_SECONDS=60
BAHNWATCH_IDLE_POLL_SECONDS=600
BAHNWATCH_ACTIVE_WINDOW_MIN=90
